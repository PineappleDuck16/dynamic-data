<div class="container mt-5">
  <div class="row">
    <div class="col-md-8">
        <ul class="list-group">
          {{#each orderdata.orders}}
            <li class="list-group-item d-flex align-items-center">
              <img src="{{this.image}}" class="img-thumbnail me-3" alt="{{this.title}}" style="max-width: 100px;">
              <div class="flex-grow-1">
                <h5 class="mb-1">{{this.title}}</h5>
                <p class="mb-1 text-muted">{{this.description}}</p>
              </div>
              <a href="/order/delete/{{this.id}}" class="btn btn-outline-danger btn-sm">Remove</a>
            </li>
          {{/each}}
        </ul>
    </div>
  </div>
</div>

