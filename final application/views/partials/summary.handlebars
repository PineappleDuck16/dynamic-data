<div class="summary-container p-4">
    <div class="summary-content">
        {{#each data.summary}}
            <p class="lead summary-text">
                <span class="summary-highlight">Goose Duck Design</span> {{this.highlight}}
            </p>
            <p class="lead summary-text">
                {{this.addition}}
            </p>
        {{/each}}
    </div>
</div>

<style>
.summary-container {
    background: linear-gradient(145deg, #ffffff, #f0f0f0);
    border-radius: 15px;
    box-shadow: 10px 10px 20px #d9d9d9,
                -10px -10px 20px #ffffff;
    margin: 2rem auto;
    max-width: 800px;
}

.summary-content {
    border-left: 4px solid #28a745;
    padding-left: 20px;
}

.summary-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #2c3e50;
}

.summary-highlight {
    color: #28a745;
    font-weight: 600;
    position: relative;
    display: inline-block;
}

.summary-highlight::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 2px;
    bottom: -2px;
    left: 0;
    background-color: #28a745;
    transform: scaleX(0);
    transition: transform 0.3s ease;
}

.summary-highlight:hover::after {
    transform: scaleX(1);
}
</style>