<section class="py-5">
    <div class="container px-4 px-lg-5 my-5">
        <div class="row gx-4 gx-lg-5 align-items-center">
                    <div class="col-md-6">
                        <img class="card-img-top mb-5 mb-md-0" src="{{work.image}}" alt="..." />
                        <div class="row mt-2">
                            <div class="col-3"><img class="img-fluid" src="https://dummyimage.com/150x100/dee2e6/6c757d.jpg" alt="placeholder thumbnail 1"></div>
                            <div class="col-3"><img class="img-fluid" src="https://dummyimage.com/150x100/dee2e6/6c757d.jpg" alt="placeholder thumbnail 2"></div>
                            <div class="col-3"><img class="img-fluid" src="https://dummyimage.com/150x100/dee2e6/6c757d.jpg" alt="placeholder thumbnail 3"></div>
                            <div class="col-3"><img class="img-fluid" src="https://dummyimage.com/150x100/dee2e6/6c757d.jpg" alt="placeholder thumbnail 4"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h1 class="display-5 fw-bolder">{{work.title}}</h1>
                        <div class="fs-5 mb-5">
                        <span>Duration: {{work.duration}}</span>
                        </div>
                        <p class="lead">{{work.description}}</p>
                        <div class="d-flex">
                            <form action="/order/add" method="POST">
                                <input type="hidden" name="title" value="{{work.title}}">
                                <input type="hidden" name="duration" value="{{work.duration}}">
                                <input type="hidden" name="description" value="{{work.description}}">
                                <input type="hidden" name="image" value="{{work.image}}">
                                <input type="hidden" name="category" value="{{category}}">
                                <button class="btn btn-outline-dark flex-shrink-0" type="submit">
                                    <i class="bi-cart-fill me-1"></i>
                                    Add to cart
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
</section>

{{>related}}